{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.6.1",
  "description": "__MSG_extDescription__",
  "default_locale": "es",
  "permissions": [
    "alarms",
    "cookies",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://miaulario.unavarra.es/*",
    "https://sso.unavarra.es/*",
    "https://www.unavarra.es/*"
  ],
  "optional_host_permissions": [
    "https://send.vis.ee/*",
    "https://send.artemislena.eu/*",
    "https://send.monks.tools/*",
    "https://is.gd/*",
    "https://spoo.me/*",
    "https://tinyurl.com/*",
    "https://www2.unavarra.es/*"
  ],
  "background": {
    "scripts": [
      "lib/core.js",
      "lib/store.js",
      "lib/names.js",
      "lib/api.js",
      "lib/grades.js",
      "lib/sync.js",
      "lib/i18n.js",
      "lib/due.js",
      "lib/inbox.js",
      "lib/news.js",
      "lib/search.js",
      "lib/zip.js",
      "lib/send.js",
      "lib/guide.js",
      "lib/pdftext.js",
      "lib/degree.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://miaulario.unavarra.es/*"
      ],
      "js": [
        "lib/core.js",
        "lib/store.js",
        "lib/names.js",
        "content-early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://miaulario.unavarra.es/*"
      ],
      "js": [
        "lib/core.js",
        "lib/i18n.js",
        "lib/ui.js",
        "lib/pm.js",
        "lib/teachers.js",
        "lib/guide.js",
        "lib/degree.js",
        "lib/mail-ui.js",
        "content-banner.js",
        "content-guide.js",
        "content-shortcuts.js",
        "content-names.js",
        "content-search.js",
        "content-mail.js",
        "content-forward.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@aulario-plus.chareca",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "websiteContent"
        ]
      }
    }
  }
}
