{
  "manifest_version": 3,
  "name": "MiAulario Keep-Alive",
  "version": "1.1.0",
  "description": "Keeps your MiAulario (UPNA) session active while the browser is open. Opens the login page when the session ends.",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://miaulario.unavarra.es/*",
    "https://sso.unavarra.es/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://miaulario.unavarra.es/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MiAulario Keep-Alive"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
