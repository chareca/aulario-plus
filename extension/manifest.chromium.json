{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.5.0",
  "description": "__MSG_extDescription__",
  "default_locale": "es",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "cookies",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://miaulario.unavarra.es/*",
    "https://sso.unavarra.es/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://miaulario.unavarra.es/*"
      ],
      "js": [
        "lib/core.js",
        "lib/store.js",
        "lib/names.js",
        "content-early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://miaulario.unavarra.es/*"
      ],
      "js": [
        "lib/core.js",
        "lib/i18n.js",
        "lib/ui.js",
        "lib/pm.js",
        "lib/mail-ui.js",
        "content-banner.js",
        "content-names.js",
        "content-search.js",
        "content-mail.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
