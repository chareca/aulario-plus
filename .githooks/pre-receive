#!/usr/bin/env bash
# pre-receive hook: reject a push if a new commit, branch or tag is not correct.
# - Each new commit message must follow Conventional Commits.
# - Commit messages, authors, committers, branch names, tag names and tag messages
#   must not contain a blocked word.
#
# Install on a self-hosted Git server or on GitHub Enterprise Server:
#   1. Copy this file to hooks/pre-receive in the bare repository.
#   2. Run: chmod +x hooks/pre-receive
#   3. Run: git config hooks.blockedWords '<extended regular expression>'
# GitHub.com does not run pre-receive hooks. On GitHub.com, the workflow
# .github/workflows/commit-messages.yml does the same checks.

types='feat|fix|refactor|perf|style|test|docs|build|ops|chore'
header_regex="^(${types})(\([^()]{1,20}\))?!?: [^[:space:]].{0,99}\$"
special_regex='^(Merge .+|Revert ".+")$'
blocked_regex=${BLOCKED_WORDS:-$(git config --get hooks.blockedWords)}
zero_commit='0000000000000000000000000000000000000000'
error=0

# Show the error. If a second argument is present, show it on the next line.
reject() {
  echo "ERROR: $1" >&2
  [[ -n $2 ]] && echo "  $2" >&2
  error=1
}

has_blocked_word() {
  [[ -n $blocked_regex ]] && grep -qiE -- "$blocked_regex"
}

# Show the problem of a commit header. Show nothing if the header is correct.
header_problem() {
  local header=$1 description
  [[ $header =~ $special_regex ]] && return 0
  if ! [[ $header =~ $header_regex ]]; then
    echo "The first line does not have the correct format."
    return 0
  fi
  description=${header#*: }
  if [[ ${description:0:1} =~ [A-Z] ]]; then
    echo "Do not start the description with a capital letter."
  elif [[ $description == *. ]]; then
    echo "Do not end the description with a period."
  fi
  return 0
}

while read -r oldrev newrev refname; do
  # The push deletes a branch or a tag.
  [[ $newrev == "$zero_commit" ]] && continue

  if printf '%s\n' "$refname" | has_blocked_word; then
    reject "A branch name or a tag name contains a blocked word."
  fi

  # Annotated tag: examine the tag message and the tagger.
  if [[ $(git cat-file -t "$newrev") == tag ]] && git cat-file tag "$newrev" | has_blocked_word; then
    reject "A tag message or a tagger contains a blocked word."
  fi

  # Examine only the commits that are not in the repository.
  if [[ $oldrev == "$zero_commit" ]]; then
    span=$(git rev-list "$newrev" --not --all)
  else
    span=$(git rev-list "$oldrev..$newrev" --not --all)
  fi

  for commit in $span; do
    if git show -s --format='%B%n%an%n%ae%n%cn%n%ce' "$commit" | has_blocked_word; then
      reject "Commit $commit contains a blocked word in the message, the author or the committer."
      continue
    fi
    header=$(git show -s --format=%s "$commit")
    problem=$(header_problem "$header")
    [[ -n $problem ]] && reject "Commit $commit: $problem" "$header"
  done
done

if (( error )); then
  echo "Format: <type>(<optional scope>): <description>" >&2
  echo "Types: ${types//|/, }" >&2
fi
exit "$error"
