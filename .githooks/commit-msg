#!/usr/bin/env bash
# commit-msg hook: make sure that the commit message follows Conventional Commits
# and does not contain a blocked word.
#
# Install (one time after you clone the repository):
#   git config core.hooksPath .githooks
#   git config hooks.blockedWords '<extended regular expression>'
#
# The value of hooks.blockedWords is not in the repository. The case of the letters
# is not important. The environment variable BLOCKED_WORDS replaces this value.

types='feat|fix|refactor|perf|style|test|docs|build|ops|chore'
header_regex="^(${types})(\([^()]{1,20}\))?!?: [^[:space:]].{0,99}\$"
special_regex='^(Merge .+|Revert ".+"|(fixup|squash|amend)! .+)$'
blocked_regex=${BLOCKED_WORDS:-$(git config --get hooks.blockedWords)}

message=$(grep -v '^#' "$1")
header=$(printf '%s\n' "$message" | grep -m 1 -v '^[[:space:]]*$')

# Show the error and stop. If the second argument is "hide", do not show the first line.
fail() {
  {
    echo "ERROR: The commit message is not correct. $1"
    [[ $2 != hide && -n $header ]] && echo "  $header"
    echo "  Format: <type>(<optional scope>): <description>"
    echo "  Types: ${types//|/, }"
  } >&2
  exit 1
}

if [[ -n $blocked_regex ]]; then
  if printf '%s\n' "$message" | grep -qiE -- "$blocked_regex"; then
    fail "The message contains a blocked word." hide
  fi
  for ident in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    if git var "$ident" 2>/dev/null | grep -qiE -- "$blocked_regex"; then
      fail "The author or the committer contains a blocked word." hide
    fi
  done
fi

[[ -z $header ]] && fail "The message is empty."
[[ $header =~ $special_regex ]] && exit 0
[[ $header =~ $header_regex ]] || fail "The first line does not have the correct format."

description=${header#*: }
[[ ${description:0:1} =~ [A-Z] ]] && fail "Do not start the description with a capital letter."
[[ $description == *. ]] && fail "Do not end the description with a period."
exit 0
